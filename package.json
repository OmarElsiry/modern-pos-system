{
  "name": "pos-cashier-system",
  "version": "1.0.0",
  "description": "نظام كاشير محلي - POS System",
  "main": "dist/electron/electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "npm run build:react && tsc -p tsconfig.electron.json && electron .",
    "dev:electron:watch": "tsc -p tsconfig.electron.json && electron .",
    "build": "npm run build:react && npm run build:electron",
    "build:react": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build --config vite.config.electron.ts",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:web": "vite build",
    "dev:web": "vite",
    "dist": "npm run build && electron-builder",
    "dist:win": "powershell -Command \"Stop-Process -Name 'electron', 'نظام الكاشير' -Force -ErrorAction SilentlyContinue; Remove-Item -Recurse -Force release -ErrorAction SilentlyContinue\" && npm run build && npx electron-packager . \"نظام الكاشير\" --platform=win32 --arch=x64 --out=release/portable --overwrite --icon=build/icon.ico",
    "dist:installer": "powershell -Command \"Stop-Process -Name 'electron', 'نظام الكاشير' -Force -ErrorAction SilentlyContinue; Remove-Item -Recurse -Force release -ErrorAction SilentlyContinue\" && npm run build && electron-builder --win nsis",
    "dist:portable": "powershell -Command \"Stop-Process -Name 'electron', 'نظام الكاشير' -Force -ErrorAction SilentlyContinue; Remove-Item -Recurse -Force release -ErrorAction SilentlyContinue\" && npm run build && electron-builder --win portable",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "lint": "eslint src --ext ts,tsx",
    "postinstall": "electron-builder install-app-deps && npx electron-rebuild -f -w better-sqlite3"
  },
  "keywords": [
    "pos",
    "cashier",
    "electron",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@types/better-sqlite3": "^7.6.8",
    "@types/jest": "^29.5.11",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@types/react-resizable": "^3.0.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "electron": "^40.1.0",
    "electron-builder": "^25.1.8",
    "electron-packager": "^17.1.2",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.563.0",
    "playwright": "^1.58.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.46.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "vite": "^7.3.1",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "cmdk": "^1.1.1",
    "react-draggable": "^4.5.0",
    "react-resizable": "^3.1.3",
    "react-to-print": "^3.2.0",
    "uuid": "^9.0.1"
  },
  "build": {
    "appId": "com.pos.cashier",
    "productName": "نظام الكاشير",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!src/**/*",
      "!specs/**/*",
      "!scripts/**/*",
      "!**/*.map",
      "!**/*.ts"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "asar": true,
    "win": {
      "artifactName": "JoeCashier-Setup-${version}.${ext}",
      "sign": false,
      "forceCodeSigning": false,
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "نظام الكاشير"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "mac": {
      "target": "dmg"
    }
  }
}